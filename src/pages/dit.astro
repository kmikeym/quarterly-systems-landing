	<script is:inline>
		// ── Payback model calculator ──────────────────────────────────────
		// Reads the three gross inputs, computes Stage 1 (25% to $5K) and
		// Stage 2 (10% to $10K cap) take per event, updates bars + cumulative
		// running total + summary panel + buyout schedule.

		const STAGE1_CAP = 5000;
		const STAGE2_CAP = 10000;
		const STAGE1_RATE = 0.25;
		const STAGE2_RATE = 0.10;

		function fmt(n) {
			return '$' + Math.round(n).toLocaleString();
		}

		function calcEvent(gross, runningCum) {
			let stage1Take = 0, stage2Take = 0;
			let stage1Gross = 0, stage2Gross = 0;
			let remaining = gross;
			let cum = runningCum;

			if (cum < STAGE1_CAP && remaining > 0) {
				const headroom = STAGE1_CAP - cum;
				const wouldTake = remaining * STAGE1_RATE;
				if (wouldTake <= headroom) {
					stage1Take = wouldTake;
					stage1Gross = remaining;
					remaining = 0;
				} else {
					stage1Take = headroom;
					stage1Gross = headroom / STAGE1_RATE;
					remaining -= stage1Gross;
				}
				cum += stage1Take;
			}

			if (cum < STAGE2_CAP && remaining > 0) {
				const headroom = STAGE2_CAP - cum;
				const wouldTake = remaining * STAGE2_RATE;
				if (wouldTake <= headroom) {
					stage2Take = wouldTake;
					stage2Gross = remaining;
					remaining = 0;
				} else {
					stage2Take = headroom;
					stage2Gross = headroom / STAGE2_RATE;
					remaining -= stage2Gross;
				}
				cum += stage2Take;
			}

			const take = stage1Take + stage2Take;
			const paizleyKeeps = gross - take;

			return {
				gross, stage1Take, stage2Take, stage1Gross, stage2Gross,
				take, paizleyKeeps, cumulative: cum
			};
		}

		function updateBar(eventId, r) {
			// Bar segments represent KmikeyM's TAKE (not gross processed) so widths sum to 100%
			const stage1Pct = r.gross > 0 ? (r.stage1Take / r.gross * 100) : 0;
			const stage2Pct = r.gross > 0 ? (r.stage2Take / r.gross * 100) : 0;
			const paizleyPct = r.gross > 0 ? (r.paizleyKeeps / r.gross * 100) : 0;

			const s1 = document.getElementById('seg-' + eventId + '-stage1');
			const s2 = document.getElementById('seg-' + eventId + '-stage2');
			const sp = document.getElementById('seg-' + eventId + '-paizley');

			s1.style.width = stage1Pct + '%';
			s2.style.width = stage2Pct + '%';
			sp.style.width = paizleyPct + '%';

			s1.textContent = r.stage1Take >= 100 ? fmt(r.stage1Take) : (r.stage1Take > 0 ? '·' : '');
			s2.textContent = r.stage2Take >= 100 ? fmt(r.stage2Take) : (r.stage2Take > 0 ? '·' : '');
			sp.textContent = r.paizleyKeeps >= 1000 ? ('Paizley keeps ' + fmt(r.paizleyKeeps)) : (r.paizleyKeeps > 0 ? fmt(r.paizleyKeeps) : '');
		}

		function updateLegend(eventId, r) {
			const container = document.getElementById('legend-' + eventId);
			if (!container) return;

			// Hide all variants
			const variants = container.querySelectorAll('.legend-variant');
			variants.forEach((v) => { v.style.display = 'none'; });

			// Pick the active variant
			let variantName;
			if (r.stage1Take > 0 && r.stage2Take > 0) {
				variantName = 'both';
			} else if (r.stage1Take > 0) {
				variantName = 'stage1only';
			} else if (r.stage2Take > 0) {
				variantName = 'stage2only';
			} else {
				variantName = 'capped';
			}

			const active = container.querySelector('[data-variant="' + variantName + '"]');
			if (active) {
				active.style.display = 'inline';
				if (variantName === 'both') {
					const stage1Amt = active.querySelector('[data-amt="stage1"]');
					const stage2Amt = active.querySelector('[data-amt="stage2"]');
					if (stage1Amt) stage1Amt.textContent = fmt(r.stage1Gross);
					if (stage2Amt) stage2Amt.textContent = fmt(r.stage2Gross);
				}
			}
		}

		function recalc() {
			const grosses = [
				Number(document.getElementById('gross-1').value) || 0,
				Number(document.getElementById('gross-2').value) || 0,
				Number(document.getElementById('gross-3').value) || 0,
				Number(document.getElementById('gross-4').value) || 0
			];

			let cum = 0;

			for (let i = 0; i < 4; i++) {
				const eventId = i + 1;
				const r = calcEvent(grosses[i], cum);
				cum = r.cumulative;

				updateBar(eventId, r);
				updateLegend(eventId, r);

				const cumEl = document.getElementById('cum-' + eventId);
				cumEl.textContent = fmt(cum);
				cumEl.className = cum >= STAGE2_CAP ? 'text-green-600' : 'text-purple-600';
			}
		}

		// Wire up listeners
		['gross-1', 'gross-2', 'gross-3', 'gross-4'].forEach((id) => {
			const el = document.getElementById(id);
			if (el) el.addEventListener('input', recalc);
		});

		// Initial render
		recalc();

		// ── Password gate ─────────────────────────────────────────────────
		// Password: "kidgrandma" (placeholder; change before sharing)
		const PASSWORD = 'kidgrandma';

		const gate = document.getElementById('auth-gate');
		const memo = document.getElementById('memo-content');
		const form = document.getElementById('auth-form');
		const input = document.getElementById('auth-input');
		const errEl = document.getElementById('auth-error');

		function unlock() {
			gate.style.display = 'none';
			memo.classList.remove('hidden');
		}

		// Auto-unlock if previously authenticated this session
		if (sessionStorage.getItem('dit-auth') === 'ok') {
			unlock();
		} else {
			input.focus();
		}

		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const guess = input.value.trim().toLowerCase();
			if (guess === PASSWORD) {
				sessionStorage.setItem('dit-auth', 'ok');
				errEl.classList.add('hidden');
				unlock();
			} else {
				errEl.classList.remove('hidden');
				input.value = '';
				input.focus();
			}
		});
	</script>

