---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found - Quarterly Systems" description="The page you're looking for isn't here.">
	<nav class="bg-white border-b border-gray-200">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex justify-between items-center h-16">
				<div class="flex items-center">
					<a href="/" class="text-xl font-bold text-gray-900">Quarterly Systems</a>
				</div>
				<div class="hidden md:block">
					<div class="ml-10 flex items-baseline space-x-4">
						<a href="/apps" class="text-gray-600 hover:text-purple-600 px-3 py-2 rounded-md text-sm font-medium transition-all duration-200">Apps</a>
						<a href="https://base.quarterly.systems" class="text-gray-600 hover:text-purple-600 px-3 py-2 rounded-md text-sm font-medium transition-all duration-200">Knowledge Base</a>
						<a href="/waitlist" class="text-gray-600 hover:text-purple-600 px-3 py-2 rounded-md text-sm font-medium transition-all duration-200">Contact</a>
					</div>
				</div>
			</div>
		</div>
	</nav>

	<main>
		<section class="bg-white">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32">
				<div class="text-center">
					<p class="text-base font-semibold text-purple-600">404</p>
					<h1 class="mt-4 text-4xl tracking-tight font-extrabold text-gray-900 sm:text-5xl">Page not found</h1>
					<p class="mt-6 max-w-xl mx-auto text-xl text-gray-600">
						The page you're looking for doesn't exist. The link may be old or mistyped.
					</p>
					<div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
						<a
							href="/"
							class="inline-flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 md:text-lg md:px-10"
						>
							Back to home
						</a>
						<a
							href="/apps"
							class="inline-flex items-center justify-center px-8 py-3 border border-gray-300 text-base font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 md:text-lg md:px-10"
						>
							Browse apps
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
